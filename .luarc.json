{
  "runtime": {
    "version": "LuaJIT",
    "path": [
      "?.lua",
      "?/init.lua",

      "koreader/?.lua",
      "koreader/?/init.lua",

      "koreader/frontend/?.lua",
      "koreader/frontend/?/init.lua"
    ]
  },
  "workspace": {
    "library": ["${3rd}/LuaJIT", "koreader"],
    "ignoreDir": [
      ".git",
      "koreader/.git",
      "koreader/build",
      "koreader/cache",
      "koreader/thirdparty"
    ],
    "checkThirdParty": false
  },
  "typeChecking": {
    "mode": "Strict"
  }
}
